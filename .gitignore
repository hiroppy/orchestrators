# Local Symphony runtimes generated from symphony_template
/symphonies/*
!/symphonies/.gitkeep

# Runtime data, logs, sqlite DBs, worker checkouts, and state snapshots
/data/**
!/data/**/
!/data/**/.gitkeep
/data/symphony/workspaces/*/
*.log
*.db
*.sqlite
*.sqlite3

# Local/private config and secrets
.env
.env.*
/config.ts
/config.local.ts
/watcher/config.ts
/watcher/config.local.ts
/config.json
/launchd/
/hooks/*
!/hooks/.gitkeep

# macOS/editor
node_modules/
.DS_Store
.idea/
.vscode/
*.swp
*~
