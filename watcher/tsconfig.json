{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "customConditions": ["test"],
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
