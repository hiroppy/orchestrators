{
  "name": "orchestrator-slack-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Post orchestrator state changes to Slack.",
  "type": "module",
  "scripts": {
    "start:watcher": "node src/entrypoints/watcher.ts",
    "start:symphonies": "node src/entrypoints/symphonies.ts",
    "slack:preview": "node scripts/slack-preview.ts",
    "test": "node --conditions=test --test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@slack/bolt": "5.1.0",
    "@slack/web-api": "8.1.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "orchestrator-config": "workspace:*",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
