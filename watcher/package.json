{
  "name": "orchestrator-slack-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Post orchestrator state changes to Slack.",
  "type": "module",
  "imports": {
    "#watcher-config": {
      "test": "./src/fixtures/config.ts",
      "default": "./config.ts"
    }
  },
  "scripts": {
    "start:watcher": "node src/entrypoints/watcher.ts",
    "start:symphonies": "node src/entrypoints/symphonies.ts",
    "test": "node --conditions=test --test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.0.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "26.1.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
